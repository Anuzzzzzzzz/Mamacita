    "\n",
    "marks = 72\n",
    "\n",
    "if marks >= 80:\n",
    "    grade = \"A\"\n",
    "elif marks >= 60:\n",
    "    grade = \"B\"\n",
    "elif marks >= 40:\n",
    "    grade = \"C\"\n",
    "else:\n",
    "    grade = \"Fail\"\n",
    "\n",
    "print(f\"Marks: {marks} → Grade: {grade}\")\n"
